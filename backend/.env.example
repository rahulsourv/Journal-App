# Copy to .env and fill in. Never commit the real .env.

# Render sets PORT itself; this is only for local runs.
PORT=5000

# MongoDB Atlas connection string, including the database name.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/daymark?retryWrites=true&w=majority
#
# If `querySrv ECONNREFUSED` shows up locally, the machine's DNS can't resolve
# SRV records. Use the non-SRV form from Atlas ("Connect > Drivers > older
# driver version") instead — it lists the shard hosts directly and skips the
# SRV lookup. Hosted platforms like Render resolve SRV fine.
MONGO_URI=

# Any long random string. Changing it invalidates every issued token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d
